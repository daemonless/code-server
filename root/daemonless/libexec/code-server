#!/bin/sh
if [ -n "${PASSWORD}" ]; then
    AUTH="password"
    AUTH_ARGS="--password ${PASSWORD}"
else
    AUTH="none"
    AUTH_ARGS=""
fi

cd "${DEFAULT_WORKSPACE:-/config/workspace}"
exec code-server \
    --bind-addr 0.0.0.0:8080 \
    --user-data-dir /config/data \
    --extensions-dir /config/extensions \
    --disable-telemetry \
    --auth "${AUTH}" \
    ${AUTH_ARGS} \
    "${DEFAULT_WORKSPACE:-/config/workspace}"
